# ---- LLM (free tiers) ----
GROQ_API_KEY=your_groq_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GOOGLE_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-2.0-flash

# ---- Vector store ----
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=ask_docs
QDRANT_API_KEY=

# ---- Cache ----
REDIS_URL=redis://localhost:6379/0

# ---- Registry ----
REGISTRY_DB_URL=sqlite+aiosqlite:///./data/registry/registry.db

# ---- Embedding / rerank ----
# Default = Gemini API embeddings (matches Docker/Render).
# For local sentence-transformers:
#   EMBEDDING_BACKEND=sentence-transformers
#   EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
#   EMBEDDING_DIM=384
EMBEDDING_BACKEND=api
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768
HF_TOKEN=
RERANKER_ENABLED=false
RERANKER_MODEL=BAAI/bge-reranker-base

# ---- Chunking ----
CHUNK_SIZE_TOKENS=500
CHUNK_OVERLAP_TOKENS=50
MAX_CHUNK_TOKENS=800

# ---- Observability ----
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# ---- API / security ----
# API_KEY is for curl/webhooks. The chat UI sets it as a cookie automatically.
API_KEY=local-dev-key
# Optional separate webhook secret (defaults to API_KEY when empty)
WEBHOOK_SECRET=
# Comma-separated origins, or * for all
CORS_ORIGINS=*
ENV=development
LOG_LEVEL=INFO

# ---- Optional background poller (prefer webhooks + POST /ingest/run) ----
POLLER_ENABLED=false
POLLER_INTERVAL_SECONDS=300
